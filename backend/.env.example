DATABASE_URL="postgresql://travelagencyweb_user:CHANGE_ME@travelagencyweb-postgres:5432/travelagencyweb_db?schema=public"
JWT_SECRET="change-this-to-a-random-64-char-string"
# Development only: allow dev JWT fallback when JWT_SECRET is unset
ALLOW_DEV_JWT=false
NODE_ENV=production
PORT=3027
# New agency signups: Pro trial length in days (default 7, max 90)
TRIAL_DAYS=7
# Trial onboarding drip SMS/email on day 1, 2, and last day (cron process-expiry)
TRIAL_DRIP_ENABLED=true
# Passport expiry alerts (30/14/7/3/1 days) — cron process-expiry
PASSPORT_ALERT_ENABLED=true
# PASSPORT_ALERT_SMS_LANG=bn
# Travel departure reminders (3/2/1 days before travelDateFrom)
TRAVEL_REMINDER_ENABLED=true
# TRAVEL_REMINDER_SMS_LANG=bn
# Set to 1 when behind nginx/reverse proxy (required for rate limiting with X-Forwarded-For)
TRUST_PROXY=true
CORS_ORIGIN="https://travelagencyweb.com,https://www.travelagencyweb.com,https://app.travelagencyweb.com,https://portal.travelagencyweb.com,http://localhost:8080,http://localhost:5173"

# Auth rate limits (requests per IP per minute)
AUTH_RATE_LIMIT_MAX=10
PORTAL_AUTH_RATE_LIMIT_MAX=10

# Customer / supplier portal URL (used inside magic-link emails)
PORTAL_URL=https://portal.travelagencyweb.com
UPLOAD_DIR="/app/uploads"
LOG_DIR="/app/logs"
PUBLIC_UPLOAD_URL="https://api.travelagencyweb.com/uploads"


# ── SMTP (optional — emails logged to console without these) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@travelagencyweb.com
SMTP_FROM_NAME=Travel Agency Web

# Frontend URL for email links and payment callbacks
FRONTEND_URL=https://travelagencyweb.com

# Backend API base URL (for payment gateway callbacks)
API_BASE_URL=https://api.travelagencyweb.com/api

# Admin notification email (receives demo/contact form alerts)
ADMIN_NOTIFICATION_EMAIL=

# Super admin alerts for new agency signup + subscription payments
SUPER_ADMIN_ALERT_EMAIL=
SUPER_ADMIN_ALERT_PHONE=

# Staff app URL (used in subscription notification emails)
APP_URL=https://app.travelagencyweb.com

# Cron secret for subscription expiry job
CRON_SECRET=

# ── SSLCommerz ──
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ── bKash ──
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Manual subscription proof — receiver numbers (send-money / bank)
BKASH_ACCOUNT_NAME=
BKASH_ACCOUNT_NUMBER=
BKASH_INSTRUCTIONS=
NAGAD_ACCOUNT_NAME=
NAGAD_ACCOUNT_NUMBER=
NAGAD_INSTRUCTIONS=
ROCKET_ACCOUNT_NAME=
ROCKET_ACCOUNT_NUMBER=
ROCKET_INSTRUCTIONS=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_BRANCH=
BANK_TRANSFER_INSTRUCTIONS=

# ── Seed (development / controlled production re-seed) ──
SEED_ADMIN_EMAIL=digiwebdex@gmail.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=user@demo.com
SEED_DEMO_PASSWORD=
ALLOW_SEED_PASSWORD_RESET=false

# ── SMS ──
SMS_PROVIDER=console
SMS_ENABLED=true
# BulkSMSBD (https://bulksmsbd.net) — set provider=bulksmsbd for live SMS
SMS_API_KEY=
SMS_SENDER_ID=
# Optional override (default https://bulksmsbd.net/api)
SMS_BASE_URL=http://bulksmsbd.net/api
# Trial expiry SMS language: bn or en
TRIAL_EXPIRY_SMS_LANG=bn
# For Twilio (alternative provider):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── WhatsApp ──
WHATSAPP_PROVIDER=console
# For Twilio WhatsApp:
WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
# For Meta WhatsApp Business:
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
# For WasenderAPI (wasenderapi.com):
WASENDER_API_KEY=
WASENDER_INSTANCE_ID=

# ── Advanced / optional (read by code — documented in Phase 4A cleanup) ──
# Disable ALL rate limiting (tests/local only — MUST be unset in production).
# RATE_LIMIT_DISABLED=true
# Rate-limit window overrides in ms (default 60000).
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# PORTAL_AUTH_RATE_LIMIT_WINDOW_MS=60000
# Number of proxy hops to trust for X-Forwarded-For (default derived from TRUST_PROXY).
# TRUST_PROXY_HOPS=1
# TTL (ms) for the verified custom-domain CORS lookup cache (default 60000).
# CUSTOM_DOMAIN_CORS_CACHE_MS=60000

# ── Telegram alerts (optional — super-admin ops notifications) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
