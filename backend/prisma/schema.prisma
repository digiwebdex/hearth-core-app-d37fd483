generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String?               @unique
  ownerId               String?
  phone                 String?
  whatsapp              String?
  address               String?
  city                  String?
  country               String?
  website               String?
  logo                  String?
  notes                 String?
  subscriptionPlan      String                @default("free")
  subscriptionStatus    String                @default("active")
  subscriptionExpiry    DateTime?
  enableHajjUmrahModule Boolean               @default(true)
  enableBdOperationsModule Boolean              @default(false)
  enabledServiceTypes   String[]                @default([])
  enabledSubcategories  String[]                @default([])
  enabledModules        String[]                @default([])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  users                 User[]
  clients               Client[]
  agents                Agent[]
  vendors               Vendor[]
  leads                 Lead[]
  complaints            Complaint[]
  campaigns             Campaign[]
  crmConfig             CrmConfig?
  agentTransactions     AgentTransaction[]
  visaStocks            VisaStock[]
  tasks                 Task[]
  supportTickets        SupportTicket[]
  staffProfiles         StaffProfile[]
  staffAttendance       StaffAttendance[]
  staffLeaveRequests    StaffLeaveRequest[]
  websitePosts          WebsitePost[]
  bookings              Booking[]
  invoices              Invoice[]
  invoiceInstallments   InvoiceInstallment[]
  payments              Payment[]
  quotations            Quotation[]
  accounts              Account[]
  transactions          Transaction[]
  expenses              Expense[]
  hajjPackages          HajjPackage[]
  hajjGroups            HajjGroup[]
  hajjPilgrims          HajjPilgrim[]
  vendorBills           VendorBill[]
  subscriptions         Subscription[]
  paymentRequests       PaymentRequest[]
  domains               TenantDomain[]
  subscriptionHistories SubscriptionHistory[]
  travelPackages        TravelPackage[]
  smsSettings           SmsSettings?
  taxRules              TaxRule[]
  salaryStructures      SalaryStructure[]
  payrollRuns           PayrollRun[]
  payslipEntries        PayslipEntry[]
  loyaltyRule           LoyaltyRule?
  loyaltyAccounts       LoyaltyAccount[]
  loyaltyTransactions   LoyaltyTransaction[]
  referralCodes         ReferralCode[]
  referralConversions   ReferralConversion[]
  groupTours            GroupTour[]
  miceEvents            MiceEvent[]
  travelPolicies        TravelPolicy[]
  travelApprovals       TravelApprovalRequest[]
  visaApplications      VisaApplication[]
  hotelContracts        HotelContract[]
  transportContracts    TransportContract[]
  jobPostings           JobPosting[]
  jobApplications       JobApplication[]
  ticketRefunds         TicketRefund[]
  ticketVoids           TicketVoid[]
  ticketReissues        TicketReissue[]
  bspUploads            BspUpload[]
}

model TenantDomain {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain             String   @unique
  wwwRedirect        String   @default("www-to-root")
  status             String   @default("pending")
  sslStatus          String   @default("none")
  verificationStatus String   @default("unverified")
  verificationToken  String
  isPrimary          Boolean  @default(false)
  lastDnsCheck       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  role              String   @default("sales_agent")
  status            String   @default("pending")
  phone             String?
  whatsapp          String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  emailVerified     Boolean  @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  whatsappVerified  Boolean  @default(false)
  approvedAt        DateTime?
  approvedBy        String?
  rejectionReason   String?
  lastLoginAt       DateTime?
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt              DateTime                @default(now())
  agentCommissionProfile AgentCommissionProfile?
  staffProfile           StaffProfile?
}

model WhatsappOtp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  purpose   String   @default("signup")
  expiresAt DateTime
  attempts  Int      @default(0)
  sendCount Int      @default(1)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model StaffProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobTitle         String?
  department       String?
  joinDate         String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  salaryStructure  SalaryStructure?
  payslips         PayslipEntry[]

  @@index([tenantId])
}

model StaffAttendance {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      String
  status    String   @default("present")
  checkIn   String?
  checkOut  String?
  notes     String?
  markedBy  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
}

model StaffLeaveRequest {
  id          String    @id @default(uuid())
  userId      String
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveType   String    @default("annual")
  startDate   String
  endDate     String
  reason      String    @default("")
  status      String    @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status])
}

model Client {
  id               String   @id @default(uuid())
  name             String
  phone            String   @default("")
  email            String   @default("")
  alternatePhone   String?
  address          String?
  dateOfBirth      String?
  passportNumber   String?
  passportExpiry   String?
  nidNumber        String?
  nationality      String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  companyName      String?
  clientType       String   @default("individual")
  tags             String[] @default([])
  walletBalance    Float    @default(0)
  creditLimit      Float?
  contractRef      String?
  contractExpiry   String?
  customFields     Json?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familyMembers      ClientFamilyMember[]
  walletTransactions WalletTransaction[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bookings         Booking[]
  invoices         Invoice[]
  leads            Lead[]
  quotations       Quotation[]
  documents        ClientDocument[]
  supportTickets   SupportTicket[]
  loyaltyAccount   LoyaltyAccount?
  miceEvents       MiceEvent[]
  visaApplications VisaApplication[]

  @@index([tenantId, createdAt])
  @@index([tenantId, clientType])
}

model ClientDocument {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  type       String
  url        String
  uploadedAt DateTime @default(now())
}

model Agent {
  id                String                  @id @default(uuid())
  name              String
  phone             String                  @default("")
  email             String                  @default("")
  address           String?
  balance           Float                   @default(0)
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime                @default(now())
  bookings          Booking[]
  commissionProfile AgentCommissionProfile?
  transactions      AgentTransaction[]
}

model AgentTransaction {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String   @default("deposit")
  amount    Float
  balance   Float    @default(0)
  method    String?
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([agentId])
}

model VisaStock {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visaType     String
  country      String?
  duration     String?
  sponsorId    String?
  visaId       String?
  occupation   String?
  buyingPrice  Float    @default(0)
  sellingPrice Float    @default(0)
  profit       Float    @default(0)
  status       String   @default("available")
  buyerName    String?
  agentId      String?
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
}

model AgentCommissionProfile {
  agentId        String   @id
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commissionRate Float    @default(0)
  status         String   @default("active")
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
}

model BookingAgentCommission {
  bookingId             String  @id
  booking               Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agentCommissionAmount Float?
  agentCommissionStatus String? @default("pending")
}

model Vendor {
  id            String   @id @default(uuid())
  name          String
  phone         String   @default("")
  email         String   @default("")
  category      String   @default("other")
  contactPerson String?
  address       String?
  serviceAreas  String?
  website       String?
  bankDetails   String?
  notes         String?
  status        String   @default("active")
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bills         VendorBill[]
  vendorNotes   VendorNote[]
  expenses      Expense[]
}

model VendorBill {
  id          String              @id @default(uuid())
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookingId   String?
  segmentId   String?
  description String
  totalAmount Float               @default(0)
  paidAmount  Float               @default(0)
  dueAmount   Float               @default(0)
  status      String              @default("unpaid")
  dueDate     String?
  invoiceRef  String?
  notes       String?
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  payments    VendorBillPayment[]
}

model VendorBillPayment {
  id        String     @id @default(uuid())
  billId    String
  bill      VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Float
  method    String
  reference String?
  date      String
  notes     String?
  paidBy    String?
  createdAt DateTime   @default(now())
}

model VendorNote {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type      String   @default("note")
  content   String
  createdBy String?
  createdAt DateTime @default(now())
}

model Lead {
  id             String   @id @default(uuid())
  name           String
  phone          String   @default("")
  email          String   @default("")
  status         String   @default("new")
  source         String?
  destination    String?
  travelDateFrom String?
  travelDateTo   String?
  travelerCount  Int?
  budget         Float?
  score          Int      @default(0)
  assignedTo     String?
  nextFollowUp   String?
  notes          String?
  tags           String[] @default([])
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activities     LeadActivity[]
  quotations     Quotation[]

  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, createdAt])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  content   String
  oldStatus String?
  newStatus String?
  createdBy String?
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  status      String   @default("todo")
  priority    String   @default("medium")
  dueDate     String?
  assignedTo  String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model SupportTicket {
  id              String    @id @default(uuid())
  ticketNumber    String
  subject         String
  description     String    @default("")
  status          String    @default("open")
  priority        String    @default("medium")
  category        String    @default("general")
  source          String    @default("internal")
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  bookingId       String?
  booking         Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignedTo      String?
  createdBy       String?
  resolutionNotes String?
  resolvedAt      DateTime?
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
}

model WebsitePost {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  excerpt     String    @default("")
  body        String    @default("")
  coverImage  String?
  status      String    @default("draft")
  publishedAt     DateTime?
  authorName      String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Booking {
  id                   String                 @id @default(uuid())
  type                 String                 @default("package")
  title                String?
  clientId             String
  client               Client                 @relation(fields: [clientId], references: [id])
  agentId              String?
  agent                Agent?                 @relation(fields: [agentId], references: [id])
  quotationId          String?
  packageId            String?
  travelPackage        TravelPackage?         @relation(fields: [packageId], references: [id])
  serviceType          String?
  packageTitleSnapshot String?
  packageCodeSnapshot  String?
  destination          String?
  travelDateFrom       String?
  travelDateTo         String?
  travelerCount        Int?
  amount               Float                  @default(0)
  cost                 Float                  @default(0)
  profit               Float                  @default(0)
  paidAmount           Float                  @default(0)
  dueAmount            Float                  @default(0)
  paymentStatus        String                 @default("unpaid")
  status               String                 @default("pending")
  assignedTo           String?
  supplierName         String?
  supplierRef          String?
  internalNotes        String?
  serviceDetails       Json?
  opsStatus            String?                @default("pending")
  followUpDate         DateTime?
  followUpNote         String?
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  segments             BookingSegment[]
  travelers            BookingTraveler[]
  checklist            BookingChecklistItem[]
  timeline             BookingTimelineEvent[]
  documents            BookingDocument[]
  invoices             Invoice[]
  agentCommission      BookingAgentCommission?
  supportTickets       SupportTicket[]
  groupTourBookings    GroupTourBooking[]
  visaApplications     VisaApplication[]
  ticketRefunds        TicketRefund[]
  ticketVoids          TicketVoid[]
  ticketReissues       TicketReissue[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, agentId])
  @@index([tenantId, followUpDate])
}

model BookingSegment {
  id           String  @id @default(uuid())
  bookingId    String
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type         String
  description  String
  supplier     String?
  supplierRef  String?
  startDate    String?
  endDate      String?
  details      String?
  cost         Float   @default(0)
  sellingPrice Float   @default(0)
  status       String  @default("pending")
}

model BookingTraveler {
  id             String  @id @default(uuid())
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name           String
  passportNumber String?
  passportExpiry String?
  nationality    String?
  dateOfBirth    String?
  phone          String?
  email          String?
  notes          String?
}

model BookingChecklistItem {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  doneAt    DateTime?
  doneBy    String?
}

model BookingTimelineEvent {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  content   String
  oldStatus String?
  newStatus String?
  createdBy String?
  createdAt DateTime @default(now())
}

model BookingDocument {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name       String
  type       String
  url        String
  uploadedAt DateTime @default(now())
  uploadedBy String?
}

model Invoice {
  id             String             @id @default(uuid())
  invoiceNumber  String?
  bookingId      String
  booking        Booking            @relation(fields: [bookingId], references: [id])
  clientId       String?
  client         Client?            @relation(fields: [clientId], references: [id])
  clientName     String?
  bookingTitle   String?
  totalAmount    Float              @default(0)
  paidAmount     Float              @default(0)
  dueAmount      Float              @default(0)
  refundedAmount Float              @default(0)
  status         String             @default("unpaid")
  dueDate        String?
  issuedDate     String?
  notes          String?
  cancelReason   String?
  taxRuleId      String?
  taxRate        Float              @default(0)
  taxAmount      Float              @default(0)
  subTotal       Float              @default(0)
  createdBy      String?
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payments       Payment[]
  refunds        InvoiceRefund[]
  auditTrail     InvoiceAuditEvent[]
  installments   InvoiceInstallment[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
}

model InvoiceInstallment {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label      String
  amount     Float    @default(0)
  dueDate    String?
  paidAmount Float    @default(0)
  status     String   @default("pending")
  sortOrder  Int      @default(0)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingId      String
  amount         Float
  method         String
  transactionRef String?
  proofUrl       String?
  date           String
  notes          String?
  receivedBy     String?
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceId])
}

model InvoiceRefund {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String
  method      String?
  processedBy String?
  createdAt   DateTime @default(now())
}

model InvoiceAuditEvent {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type       String
  content    String
  oldStatus  String?
  newStatus  String?
  amount     Float?
  createdBy  String?
  createdAt  DateTime @default(now())
}

model Quotation {
  id                   String             @id @default(uuid())
  title                String
  clientId             String?
  client               Client?            @relation(fields: [clientId], references: [id])
  leadId               String?
  lead                 Lead?              @relation(fields: [leadId], references: [id])
  packageId            String?
  travelPackage        TravelPackage?     @relation(fields: [packageId], references: [id])
  serviceType          String?
  packageTitleSnapshot String?
  packageCodeSnapshot  String?
  destination          String
  travelDateFrom       String?
  travelDateTo         String?
  travelerCount        Int                @default(1)
  status               String             @default("draft")
  version              Int                @default(1)
  items                Json               @default("[]")
  itinerary            Json               @default("[]")
  totalCost            Float              @default(0)
  totalSelling         Float              @default(0)
  totalProfit          Float              @default(0)
  discountAmount       Float              @default(0)
  taxAmount            Float              @default(0)
  grandTotal           Float              @default(0)
  validUntil           String?
  notes                String?
  termsAndConditions   String?
  createdBy            String?
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  versions             QuotationVersion[]
}

model QuotationVersion {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      String
  changeNote    String?
  changedBy     String?
  createdAt     DateTime  @default(now())
}

model Account {
  id            String        @id @default(uuid())
  name          String
  type          String
  balance       Float         @default(0)
  accountNumber String?
  bankName      String?
  notes         String?
  status        String        @default("active")
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  expenses      Expense[]
}

model Transaction {
  id            String   @id @default(uuid())
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
  type          String
  category      String
  description   String
  amount        Float
  referenceId   String?
  referenceType String?
  clientId      String?
  bookingId     String?
  vendorId      String?
  invoiceId     String?
  paymentMethod String?
  status        String   @default("completed")
  date          String
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     String?
  createdAt     DateTime @default(now())
}

model Expense {
  id            String   @id @default(uuid())
  category      String
  description   String
  amount        Float
  date          String
  paymentMethod String
  reference     String?
  notes         String?
  attachmentUrl String?
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
